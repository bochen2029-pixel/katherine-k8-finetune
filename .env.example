# Copy this file to .env and fill in your real key.
# .env is gitignored. Do NOT commit your real key.

# Anthropic API key for bulk Tier 1 trace generation via scripts/generate_traces.py
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used for generation. Defaults to claude-opus-4-5.
# Higher-quality models cost more but produce better traces for K8's
# texture-dependent persona.
# K8_GEN_MODEL=claude-opus-4-5

# Optional: HuggingFace token (used by push_to_hf.py at training time)
# Get one at: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_...
